# Local demo of the public restyle: `npm run demo` (vite --mode demo).
# Only used by the dev server in "demo" mode; never by `vite build`.
# The existing hooks keep their endpoints/payloads; the base URL simply points to the local
# mock in mock/demo-api.ts, so no message, application or CV leaves the machine.
VITE_API_BASE_URL=/__demo-api

# No analytics or e-mail delivery from the demo.
VITE_CLARITY_ID=
VITE_GA_MEASUREMENT_ID=
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_SITE_ID=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
