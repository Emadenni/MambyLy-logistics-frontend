  "captions": [
    {
      "from": 0,
      "to": 3,
      "text": "Du fick ett\n*visitkort* i går.",
      "instant": true
    },
    {
      "from": 3,
      "to": 6,
      "text": "Var är det *nu?*"
    },
    {
      "from": 6,
      "to": 9,
      "text": "Papperskort\n*kommer bort.*"
    },
    {
      "from": 9,
      "to": 10.5,
      "text": "Och kontakten\n*med dem.*"
    },
    {
      "from": 10.5,
      "to": 12,
      "text": "Det går\n*enklare.*"
    },
    {
      "from": 12,
      "to": 17,
      "text": "Ditt kort.\n*Digitalt.*"
    },
    {
      "from": 17,
      "to": 19,
      "text": "*Dela*\nlänken."
    },
    {
      "from": 19,
      "to": 22,
      "text": "Visa\n*QR-koden.*"
    },
    {
      "from": 22,
      "to": 24,
      "text": "Kunden\n*skannar.*"
    },
    {
      "from": 24,
      "to": 27,
      "text": "Kortet\n*öppnas.*"
    },
    {
      "from": 27,
      "to": 30,
      "text": "Ett tryck:\n*Spara kontakt.*"
    },
    {
      "from": 30,
      "to": 34.5,
      "text": "Lätt att hitta\nnär *behovet uppstår.*",
      "size": 92
    },
    {
      "from": 34.5,
      "to": 40,
      "text": "Inte bara\nen *bild.*"
    },
    {
      "from": 40,
      "to": 52,
      "text": "Ett uttryck för\n*varje företag.*"
    },
    {
      "from": 52,
      "to": 62,
      "text": "Och hemsidor som\ngör *samma intryck.*"
    },
    {
      "from": 67.4,
      "to": 68,
      "text": "Du fick ett\n*visitkort* i går.",
      "stagger": 1,
      "hold": true
    }
  ],
  "close": {
    "text": "*Testa våra exempel*\n– länk i bio"
